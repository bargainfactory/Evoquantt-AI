# ============================================================
# EvoQuant AI - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- App ----
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
APP_NAME=EvoQuantAI
APP_URL=http://localhost:3000

# ---- Database ----
POSTGRES_USER=evoquant
POSTGRES_PASSWORD=evoquant_secret
POSTGRES_DB=evoquant
DATABASE_URL=postgresql+asyncpg://evoquant:evoquant_secret@localhost:5432/evoquant

# ---- Redis ----
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ---- Quantum-Proof Security (liboqs) ----
PQ_VAULT_MASTER_KEY=your-pq-vault-master-key-64-hex-chars
PQ_KEM_ALGORITHM=Kyber768
PQ_SIG_ALGORITHM=Dilithium2
VAULT_ENCRYPTION_ENABLED=true

# ---- JWT ----
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- TOTP / 2FA ----
TOTP_ISSUER=EvoQuantAI
TOTP_ENABLED=true

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=EvoQuant AI

# ---- WalletConnect v2 ----
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ---- Ethereum / EVM ----
NEXT_PUBLIC_ALCHEMY_ETH_MAINNET=your-alchemy-eth-mainnet-key
NEXT_PUBLIC_ALCHEMY_ETH_SEPOLIA=your-alchemy-eth-sepolia-key
UNISWAP_V4_POOL_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# ---- Solana ----
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Jupiter (Solana DEX) ----
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_API_KEY=

# ---- Crypto Exchange APIs (ccxt-pro) ----
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET=your-binance-secret
BINANCE_TESTNET=true

BYBIT_API_KEY=your-bybit-api-key
BYBIT_SECRET=your-bybit-secret
BYBIT_TESTNET=true

COINBASE_API_KEY=your-coinbase-api-key
COINBASE_SECRET=your-coinbase-secret

KRAKEN_API_KEY=your-kraken-api-key
KRAKEN_SECRET=your-kraken-secret

OKX_API_KEY=your-okx-api-key
OKX_SECRET=your-okx-secret
OKX_PASSPHRASE=your-okx-passphrase

# ---- Interactive Brokers ----
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_PAPER_TRADING=true

# ---- E*TRADE OAuth2 ----
ETRADE_CONSUMER_KEY=your-etrade-consumer-key
ETRADE_CONSUMER_SECRET=your-etrade-consumer-secret
ETRADE_SANDBOX=true
ETRADE_CALLBACK_URL=http://localhost:8000/api/brokers/etrade/callback

# ---- Charles Schwab ----
SCHWAB_APP_KEY=your-schwab-app-key
SCHWAB_APP_SECRET=your-schwab-app-secret
SCHWAB_CALLBACK_URL=http://localhost:8000/api/brokers/schwab/callback

# ---- Fidelity ----
FIDELITY_API_KEY=your-fidelity-api-key
FIDELITY_SECRET=your-fidelity-secret

# ---- Tradier ----
TRADIER_ACCESS_TOKEN=your-tradier-access-token
TRADIER_SANDBOX=true

# ---- Market Data APIs ----
FINNHUB_API_KEY=your-finnhub-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
POLYGON_API_KEY=your-polygon-api-key
QUANDL_API_KEY=your-quandl-api-key
FRED_API_KEY=your-fred-api-key
TIINGO_API_KEY=your-tiingo-api-key

# ---- News / Sentiment ----
NEWS_API_KEY=your-newsapi-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---- On-Chain Data ----
ETHERSCAN_API_KEY=your-etherscan-api-key
GLASSNODE_API_KEY=your-glassnode-api-key
COINGLASS_API_KEY=your-coinglass-api-key

# ---- Celery ----
CELERY_BROKER_URL=redis://:redis_secret@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret@localhost:6379/2

# ---- Rate Limits ----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# ---- ML / Optimization ----
OPTUNA_STORAGE=sqlite:///optuna.db
MODEL_CACHE_DIR=/app/models/cache
LSTM_EPOCHS=50
LSTM_BATCH_SIZE=32
EVOLUTION_NIGHTLY_ENABLED=true
RECURSIVE_SELL_MAX_DEPTH=10
